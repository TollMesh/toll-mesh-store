{
  "name": "toll-mesh/cache",
  "type": "library",
  "description": "PHP SDK for TollMeshCache - Distributed CRDT-based caching and coordination",
  "keywords": ["cache", "crdt", "distributed", "rate-limiting", "coordination", "replica"],
  "homepage": "https://github.com/TollMesh/toll-mesh-store",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "TollMesh Team",
      "email": "team@tollmesh.io",
      "homepage": "https://tollmesh.io"
    }
  ],
  "require": {
    "php": ">=8.0",
    "guzzlehttp/guzzle": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "phpstan/phpstan": "^1.8",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "TollMesh\\Cache\\": "sdks/php/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TollMesh\\Cache\\Tests\\": "sdks/php/tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyze": "phpstan analyse sdks/php/src",
    "lint": "phpcs --standard=PSR12 sdks/php/src sdks/php/tests"
  }
}
