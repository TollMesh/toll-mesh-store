{
  "name": "@tollmesh/tollmeshcache",
  "version": "1.1.0",
  "description": "Node.js/TypeScript SDK for TollMeshCache - Distributed CRDT-based caching",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "TollMesh Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/toll-mesh/store.git"
  },
  "keywords": [
    "cache",
    "crdt",
    "distributed",
    "rate-limiting",
    "replay-protection",
    "coordination"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:cov": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm run test && npm run lint",
    "docs": "typedoc"
  },
  "dependencies": {
    "axios": "^1.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}
