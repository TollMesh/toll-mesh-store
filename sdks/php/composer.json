{
  "name": "toll-mesh/cache",
  "type": "library",
  "description": "PHP SDK for TollMeshCache - Distributed CRDT-based caching",
  "keywords": ["cache", "crdt", "distributed", "rate-limiting", "coordination"],
  "homepage": "https://github.com/toll-mesh/store",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "TollMesh Team",
      "email": "team@tollmesh.io",
      "homepage": "https://tollmesh.io"
    }
  ],
  "require": {
    "php": ">=8.0",
    "guzzlehttp/guzzle": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "phpstan/phpstan": "^1.8",
    "squizlabs/php_codesniffer": "^3.7",
    "grpc/grpc": "^1.48"
  },
  "autoload": {
    "psr-4": {
      "TollMesh\\Cache\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TollMesh\\Cache\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyze": "phpstan analyse src",
    "lint": "phpcs --standard=PSR12 src tests",
    "fix": "phpcbf --standard=PSR12 src tests"
  }
}
